# Google Gemini / Vertex AI Configuration
# (Required for LLM calls and embeddings)
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# Embedding dimension used for the vector index
DOCUMIND_EMBED_DIM=768

# LangSmith Tracing (Optional)
# Enable observability and debugging for LangChain operations.
# To get a LangSmith API key:
#   1. Visit https://smith.langchain.com
#   2. Sign up for a free account
#   3. Navigate to Settings > Create API key
#   4. Copy the key and paste it below (do NOT commit real keys to git)
#
# When enabled, every ask_documind() call will be traced to your LangSmith dashboard.
# Traces include: query text, retrieved chunks, cross-encoder reranking scores, final answer.

# LangSmith API key (get from https://smith.langchain.com/settings)
# LANGSMITH_API_KEY=your-langsmith-api-key-here

# Enable LangChain tracing (set to 'true' to enable, 'false' to disable)
# LANGCHAIN_TRACING_V2=true

# LangSmith project name (optional, defaults to 'default')
# LANGCHAIN_PROJECT=documind-landlord
