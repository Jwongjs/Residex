rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== DOCUMIND CHUNKS ==========
    // Read-only for landlords (only backend can write)
    match /documind_chunks/{chunkId} {
      allow read: if request.auth != null && 
                     resource.data.landlord_id == request.auth.uid;
      allow write: if false; // Only backend service account can write
    }
    
    // ========== DOCUMIND DOCUMENT METADATA ==========
    match /documind_docs/{docId} {
      allow read: if request.auth != null && 
                     resource.data.landlord_id == request.auth.uid;
      allow write: if false; // Only backend service account can write
    }
    
    // ========== PROPERTIES (for property name lookup) ==========
    match /properties/{propertyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.landlordId;
      allow update, delete: if request.auth != null &&
                                request.auth.uid == resource.data.landlordId;

      // ========== UNITS (per-property rentable units) ==========
      match /units/{unitId} {
        allow read, write: if request.auth != null &&
            request.auth.uid == get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId;
      }
    }
    
    // ========== USERS ==========
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========== LEASES (Future) ==========
    match /leases/{leaseId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend can write
    }
  }
}